# .env.example — 값은 플레이스홀더만. 실제 값은 .env(gitignore됨)에 둔다.
# 시크릿(액세스 키)은 이 파일에 쓰지 않는다. AWS CLI 프로필로 인증한다.

# 모의 Bedrock 클라이언트 사용 여부. 오프라인 테스트는 true.
HAZOP_USE_MOCK=true

# AWS CLI 자격증명 프로필 이름 (~/.aws/credentials)
AWS_PROFILE=<your-aws-profile>

# Bedrock 리전. config/models.yaml 값이 우선하며, 이 값은 도구 스크립트 기본값.
AWS_REGION=ap-northeast-2

# provider=anthropic 일 때만 필요 (REQ-12). 코드·yaml·로그에는 키를 두지 않는다.
ANTHROPIC_API_KEY=<your_key>

# Streamlit 데모의 실호출 모드 허용 (FR-10). true 이고 ANTHROPIC_API_KEY 가 있을 때만 켜진다. 공개 배포는 false.
HAZOP_ALLOW_LIVE=false

# 한글 출력 깨짐 방지 (Windows 필수)
PYTHONIOENCODING=utf-8
