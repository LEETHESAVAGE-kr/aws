# .env.example — 값은 플레이스홀더만. 실제 값은 .env(gitignore됨)에 둔다.
# 시크릿(액세스 키)은 이 파일에 쓰지 않는다. AWS CLI 프로필로 인증한다.

# 모의 Bedrock 클라이언트 사용 여부. 오프라인 테스트는 true.
HAZOP_USE_MOCK=true

# AWS CLI 자격증명 프로필 이름 (~/.aws/credentials)
AWS_PROFILE=<your-aws-profile>

# Bedrock 리전. config/models.yaml 값이 우선하며, 이 값은 도구 스크립트 기본값.
AWS_REGION=ap-northeast-2

# 한글 출력 깨짐 방지 (Windows 필수)
PYTHONIOENCODING=utf-8
